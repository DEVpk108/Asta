+}
+@media (max-width: 900px) {
+  .chat,
+  .chat.chat-fullscreen,
+  .chat:not(.chat-show-history),
+  .chat.chat-fullscreen:not(.chat-show-history) {
+    grid-template-columns: minmax(0, 1fr) 280px;
+  }
+  .chat-recent {
+    position: absolute;
+    top: 52px;
+    bottom: 32px;
+    left: 0;
+    width: 240px;
+    z-index: 10;
+    box-shadow: 8px 0 20px rgba(0, 0, 0, 0.12);
+  }
+  .chat-header {
+    padding: 20px 16px;

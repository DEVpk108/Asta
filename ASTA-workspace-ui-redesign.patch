+    --blue: #8bbaff;
+    --blue-soft: #25354d;
+    --green: #87d4a7;
+    --amber: #efbc75;
+    --red: #ff9aa3;
+    --red-soft: #3d252a;
+    --shadow: none;
+  }
+}
+:root[data-theme="dark"] {
+  --canvas: #18191c;

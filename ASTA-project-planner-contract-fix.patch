diff --git a/docs/project-planner-contract-fix.md b/docs/project-planner-contract-fix.md
new file mode 100644
index 0000000..0cb6e78
--- /dev/null
+++ b/docs/project-planner-contract-fix.md
@@ -0,0 +1,12 @@
+# Project planner contract correction
+
+Apply after ASTA-concurrent-model-services.patch, not instead of it.
+
+- Classify normalized text but preserve the original project goal, including case-sensitive code, paths and expected output.
+- Supply an explicit write/readback/run example. File verification belongs to filesystem.read_file with filesystem.file_content, matching path and decoded contents exactly.
+- A rejected readback/command-verification proposal may be regenerated once with the validator error. The validator is unchanged; no rejected plan is executed or repaired by guessed code. Other failures, including invalid JSON, are not retried by this contract correction.
+- Structured coding decisions use ASTA_CODING_AGENT_TEMPERATURE (default 0.0), independently of ordinary coding generation settings.
+- Timeout, cancellation or server-reported output-limit termination cannot return a partial executable agent proposal. Timeout alone is not diagnosed as GPU OOM.
+- “Are you generating the code?” and similar narrow status questions use background runtime state, not a model's guess. Exact project task status remains available.
+
+Acceptance: use the disposable workspace and the exact main.py / ASTA_OK request, review approval, verify file readback and actual stdout. Use on_demand until full-stack resource tuning is validated. This correction does not resolve dual-mode GPU contention, guarantee that every model follows the contract, or add larger application-generation workflows.
diff --git a/tests/test_project_planner_contract_fix.py b/tests/test_project_planner_contract_fix.py
new file mode 100644
index 0000000..06bcebd
--- /dev/null
+++ b/tests/test_project_planner_contract_fix.py
@@ -0,0 +1,79 @@
+from __future__ import annotations
+import json
+import pytest
+from core import Kernel, Planner
+from core.intent_router import IntentRouter
+from core.agent.brain import AgentBrain
+from core.planner import PlanningError
+from tests.test_workspace_project_task import FixedPlanBrain, _happy_plan, _build_runtime, _shutdown, GOAL
+
+
+def test_project_intent_keeps_exact_literals_and_paths():
+    goal = 'Create MixedCase.py containing only print("ASTA_OK"). Run it.'
+    intent = IntentRouter().analyze(goal)
+    assert intent.entities['goal'] == goal
+    assert intent.normalized_text == goal
+
+
+def test_prompt_declares_verified_readback_and_equal_decoded_content():
+    kernel = Kernel()
+    brain = AgentBrain(kernel, enabled=True)
+    intent = IntentRouter().analyze(GOAL)
+    payload = json.loads(brain._build_prompt(GOAL, intent))
+    example = payload['project_contract_example']
+    assert example[0]['content'] == example[1]['expected_content']
+    assert example[1]['verification'] == 'filesystem.file_content'
+    assert example[1]['tool'] == 'filesystem.read_file'
+    assert 'ASTA_OK' in payload['intent']['goal']
+    assert 'BEFORE executing code' in payload['instruction']
+    kernel.shutdown()
+
+
+def test_missing_readback_gets_one_replan_before_any_execution(tmp_path):
+    good = _happy_plan()
+    bad = [step for step in good if step.get('tool') != 'filesystem.read_file']
+    workspace = tmp_path/'project'; workspace.mkdir()
+    kernel, tasks, ai, tools = _build_runtime(workspace, tmp_path/'authority.json', bad, authorize_run=False)
+    brain = FixedPlanBrain(bad, replanned_steps=good)
+    kernel.planner.agent_brain = brain
+    try:
+        proposal = kernel.planner.plan(GOAL, intent=IntentRouter().analyze(GOAL))
+        assert proposal.steps
+        assert brain.plan_calls == 2
+        assert 'readback' in brain.intents[1]['planning_feedback']
+        assert not (workspace/'main.py').exists()
+        assert brain.intents[0].get('planning_feedback') is None
+    finally:
+        _shutdown(tasks, ai, tools); kernel.shutdown()
+
+
+def test_repeated_invalid_readback_stops_after_two_proposals(tmp_path):
+    bad = [step for step in _happy_plan() if step.get('tool') != 'filesystem.read_file']
+    workspace = tmp_path/'project'; workspace.mkdir()
+    kernel, tasks, ai, tools = _build_runtime(workspace, tmp_path/'authority.json', bad)
+    brain = FixedPlanBrain(bad)
+    kernel.planner.agent_brain = brain
+    try:
+        with pytest.raises(PlanningError, match='readback'):
+            kernel.planner.plan(GOAL, intent=IntentRouter().analyze(GOAL))
+        assert brain.plan_calls == 2
+        assert not (workspace/'main.py').exists()
+    finally:
+        _shutdown(tasks, ai, tools); kernel.shutdown()
+
+
+def test_incomplete_agent_output_never_returns_a_partial_plan(monkeypatch):
+    from tests.test_concurrent_models import dual
+    from tests.test_model_router import FakeEngine
+    from ai.model_router import RoutedLLMProvider, ModelRoutingError
+    kernel, runtime, managers, log = dual(monkeypatch)
+    class IncompleteEngine(FakeEngine):
+        def generate_response(self, *args, **kwargs):
+            self.last_generation = {'cancelled': True, 'timed_out': True}
+            return '{"steps": []}'
+    client = RoutedLLMProvider(runtime, purpose='agent', engine_factory=IncompleteEngine)
+    try:
+        with pytest.raises(ModelRoutingError, match='timeout'):
+            client.generate_for_task('plan', goal=GOAL, coding_scope=True)
+    finally:
+        runtime.shutdown()

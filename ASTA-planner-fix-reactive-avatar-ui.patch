+  .view-home .composer-note {
+    color: #eef4ff;
+  }
+  .avatar-frame,
+  .home-caption {
+    border-width: 2px;
+  }
+}
+.avatar-home-slot {
+  flex: 1 1 220px;
+  height: auto;
+  min-height: 220px;
+}
+.avatar-frame figcaption {
+  align-items: center;
+  pointer-events: auto;
+  bottom: 8px;
+}
+.avatar-frame #avatarMotionLabel {
+  display: none;
+}
+.avatar-frame #avatarMotionToggle {
+  background: rgba(8, 18, 30, 0.88);
+  color: #a9cfff;
+  border: 1px solid #35465d;
+  font-size: 14px;
+  min-height: 44px;
+}
+.home-caption p {
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+@media (max-width: 650px) {
+  .avatar-home-slot {
+    flex: none;
+    height: 300px;
+    min-height: 0;
+  }
+  .avatar-frame figcaption {
+    gap: 8px;
+    font-size: 14px;
+  }
+  .avatar-frame #avatarMotionToggle {
+    padding: 8px;
+  }
+}
+
+.avatar-state-heading {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 9px;
+}

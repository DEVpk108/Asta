+    display: flex;
+    flex-direction: column;
+  }
+  .conversation {
+    min-height: calc(100dvh - 84px);
+  }
+  .chat-main {
+    min-height: 460px;
+  }
+  .chat-messages {
+    min-height: 300px;
+    max-height: 65dvh;
+    padding: 24px 20px;
+  }
+  .chat-header {
+    padding: 20px 16px 12px;
+  }
+  .conversation-heading h1 {
+    font-size: 23px;
+  }
+  .conversation-heading .eyebrow {
+    font-size: 14px;
+  }
+  .header-actions {
+    gap: 0;
+  }
+  .header-actions button {
+    font-size: 14px;
+    padding: 6px;
+  }
+  .header-actions #themeToggle {
+    font-size: 20px;
+    width: 40px;
+  }
+  .voice-status {
+    padding: 0 20px 12px;
+  }
+  .chat-recent {
+    position: fixed;
+    bottom: 0;
+    width: 270px;
+    z-index: 20;
+  }
+  .composer-wrap {
+    padding: 16px;
+  }
+  .chat-input {
+    gap: 0;
+  }
+  .chat-input input {
+    font-size: 14px;
+    padding: 10px;
+  }
+  .composer-note {
+    font-size: 14px;
+  }
+  .inspector {
+    border-left: 0;
+    border-top: 1px solid var(--line);
+    padding: 24px;
+  }
+  .statusbar {
+    padding: 8px 16px;
+  }
+  .chat.chat-fullscreen .inspector {
+    display: block;
+  }
+  .tb-drag {
+    padding: 0 16px;
+  }
+  .tb-right button {
+    width: 40px;
+  }
+  .chat.chat-fullscreen .services,
+  .chat.chat-fullscreen .workspace-context {
+    display: block;
+  }
+  .inspector-header p {
+    display: block;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation: none !important;
+    transition: none !important;
+    scroll-behavior: auto !important;
+  }
+  button:active {
+    transform: none;
+  }
+  .chat-recent-delete:active {
+    transform: translateY(-50%);
+  }
+}
+@media (prefers-reduced-transparency: reduce) {
+  .titlebar,
+  .statusbar {
+    background: var(--canvas);
+    backdrop-filter: none;
+  }
+}
+@media (prefers-contrast: more) {
+  :root {
+    --muted: var(--text);
+  }
+  button,
+  .chat-input,
+  .approval-card {
+    border-width: 2px;
+  }
+  .titlebar,
+  .statusbar {
+    backdrop-filter: none;
+    background: var(--canvas);
+  }
+}
+/* Pending approval takes priority over general inspector chrome. */
+.inspector:has(.approval-card) .inspector-header {
+  display: none;
+}
+.inspector:has(.approval-card) .project-card {
+  margin-top: 0;
+  padding-top: 0;
+  border-top: 0;
+}
+.chat-input {
+  border-color: #8c8c94;
+}
+.inspector {
+  scrollbar-width: thin;
+  scrollbar-color: var(--line) transparent;
+}
+:root[data-theme="dark"] .chat-input {
+  border-color: #73757f;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) .chat-input {
+    border-color: #73757f;
+  }
+}
diff --git a/hud/renderer/workspace_ui.js b/hud/renderer/workspace_ui.js

+  boot();
+  label();
+  $("chatFullscreen").hidden = true;
+  refresh();
+})();
diff --git a/hud/renderer/workspace.css b/hud/renderer/workspace.css
new file mode 100644
index 0000000..9c55469
--- /dev/null
+++ b/hud/renderer/workspace.css
@@ -0,0 +1,1093 @@
+:root {
+  color-scheme: light dark;
+  --canvas: #f5f5f7;
+  --surface: #fff;
+  --sidebar: #eeeef1;
+  --glass: rgba(245, 245, 247, 0.88);
+  --text: #242426;
+  --muted: #626268;
+  --line: #dadade;
+  --blue: #0964d7;
+  --blue-soft: #eaf2ff;
+  --green: #257348;
+  --amber: #8b5109;
+  --red: #b52b34;
+  --red-soft: #fff0f1;
+  --shadow: 0 4px 20px rgba(28, 30, 40, 0.05);
+  font:
+    100%/1.5 system-ui,
+    -apple-system,
+    "Segoe UI",
+    sans-serif;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --canvas: #18191c;
+    --surface: #202125;
+    --sidebar: #1c1d20;
+    --glass: rgba(28, 29, 32, 0.92);
+    --text: #f4f4f5;
+    --muted: #b1b2bb;
+    --line: #42434b;
+    --blue: #8bbaff;
+    --blue-soft: #25354d;
+    --green: #87d4a7;
+    --amber: #efbc75;
+    --red: #ff9aa3;
+    --red-soft: #3d252a;
+    --shadow: none;
+  }
+}
+:root[data-theme="dark"] {
+  --canvas: #18191c;
+  --surface: #202125;
+  --sidebar: #1c1d20;
+  --glass: rgba(28, 29, 32, 0.92);
+  --text: #f4f4f5;
+  --muted: #b1b2bb;
+  --line: #42434b;
+  --blue: #8bbaff;
+  --blue-soft: #25354d;
+  --green: #87d4a7;
+  --amber: #efbc75;
+  --red: #ff9aa3;
+  --red-soft: #3d252a;
+  --shadow: none;
+}
+* {
+  box-sizing: border-box;
+}
+body {
+  margin: 0;
+  background: var(--canvas);
+  color: var(--text);
+  height: 100dvh;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  -webkit-font-smoothing: antialiased;
+}
+button,
+input {
+  font: inherit;
+}
+button {
+  cursor: pointer;
+  min-height: 44px;
+  color: var(--text);
+  border: 1px solid transparent;
+  background: transparent;
+  border-radius: 10px;
+  padding: 8px 12px;
+  touch-action: manipulation;
+}
+button:hover {
+  background: var(--blue-soft);
+}
+button:active {
+  transform: scale(0.97);
+  transition: transform 90ms ease-out;
+}
+button:disabled {
+  cursor: not-allowed;
+  opacity: 0.5;
+}
+button:focus-visible,
+input:focus-visible,
+a:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: 3px;
+}
+[hidden] {
+  display: none !important;
+}
+h1,
+h2,
+h3,
+p {
+  margin: 0;
+}
+h1 {
+  font-size: 25px;
+  line-height: 1.2;
+  letter-spacing: -0.025em;
+}
+h2 {
+  font-size: 20px;
+  letter-spacing: -0.02em;
+}
+h3 {
+  font-size: 15px;
+  line-height: 1.4;
+  font-weight: 650;
+}
+svg {
+  width: 22px;
+  height: 22px;
+}
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+}
+.titlebar {
+  height: 52px;
+  flex: 0 0 52px;
+  display: flex;
+  align-items: center;
+  background: var(--glass);
+  backdrop-filter: blur(16px);
+  border-bottom: 1px solid var(--line);
+}
+.tb-drag {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 0 20px;
+  flex: 1;
+  align-self: stretch;
+  -webkit-app-region: drag;
+}
+.is-mac .tb-drag {
+  padding-left: 90px;
+}
+.brand-mark,
+.welcome-mark {
+  font-weight: 650;
+  letter-spacing: -0.07em;
+  line-height: 1;
+  display: grid;
+  place-items: center;
+  background: var(--blue);
+  color: var(--surface);
+  border-radius: 10px;
+}
+.brand-mark {
+  height: 28px;
+  width: 28px;
+  font-size: 26px;
+}
+.brand-name {
+  font-size: 15px;
+  font-weight: 650;
+  letter-spacing: 0.02em;
+}
+.tb-sub {
+  font-size: 14px;
+  color: var(--muted);
+  padding-left: 12px;
+  border-left: 1px solid var(--line);
+}
+.tb-right {
+  display: flex;
+  -webkit-app-region: no-drag;
+}
+.tb-right button {
+  width: 48px;
+  height: 52px;
+  border-radius: 0;
+}
+.tb-right #wcClose:hover {
+  color: #fff;
+  background: #b52b34;
+}
+.is-mac .tb-right {
+  display: none;
+}
+.chat {
+  flex: 1;
+  min-height: 0;
+  display: grid;
+  grid-template-columns: 228px minmax(0, 1fr) 320px;
+}
+.chat-recent {
+  background: var(--sidebar);
+  border-right: 1px solid var(--line);
+  padding: 24px 16px 16px;
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  overflow: auto;
+}
+.sidebar-label,
+.eyebrow {
+  font-size: 14px;
+  font-weight: 650;
+  letter-spacing: 0.08em;
+  color: var(--muted);
+}
+.sidebar-label {
+  font-size: 14px;
+}
+.sidebar-top {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+}
+.new-chat {
+  text-align: left;
+  background: var(--surface);
+  box-shadow: var(--shadow);
+  border-color: var(--line);
+  font-size: 14px;
+  font-weight: 600;
+}
+.chat-recent-header {
+  margin-top: 32px;
+  margin-bottom: 14px;
+}
+.chat-recent-header h2 {
+  font-size: 14px;
+  letter-spacing: 0;
+}
+.private-label {
+  font-size: 14px;
+  color: var(--muted);
+}
+.chat-recent-list {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.chat-recent-item {
+  position: relative;
+  padding: 10px 44px 10px 10px;
+  border-radius: 10px;
+}
+.chat-recent-item.active {
+  background: var(--surface);
+  box-shadow: var(--shadow);
+}
+.chat-recent-title {
+  font-size: 14px;
+  font-weight: 550;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.chat-recent-meta {
+  font-size: 14px;
+  color: var(--muted);
+}
+.chat-recent-select {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  gap: 4px;
+  border: 0;
+  background: none;
+  text-align: left;
+  padding: 0;
+}
+.chat-recent-delete {
+  position: absolute;
+  top: 50%;
+  right: 2px;
+  transform: translateY(-50%);
+  width: 40px;
+  min-height: 44px;
+  color: var(--muted);
+  padding: 0;
+  font-size: 18px;
+}
+.chat-recent-delete:hover {
+  color: var(--red);
+  background: var(--red-soft);
+}
+.chat-recent-delete:active {
+  transform: translateY(-50%) scale(0.97);
+}
+.chat-recent-empty {
+  font-size: 14px;
+  color: var(--muted);
+  padding: 8px 0;
+}
+.sidebar-bottom {
+  margin-top: auto;
+  padding-top: 28px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 14px;
+  color: var(--muted);
+}
+.local-dot,
+.status-dot {
+  display: inline-block;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--muted);
+  flex-shrink: 0;
+}
+.local-dot {
+  background: var(--blue);
+}
+.conversation {
+  background: var(--surface);
+  min-width: 0;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+.chat-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 24px 28px 18px;
+  flex: 0 0 auto;
+}
+.conversation-heading .eyebrow {
+  display: block;
+  margin-bottom: 7px;
+}
+.header-actions {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+.quiet-button {
+  font-size: 14px;
+  border-color: var(--line);
+}
+.header-actions .quiet-button {
+  border-color: transparent;
+}
+.icon-button {
+  width: 44px;
+  padding: 9px;
+  font-size: 20px;
+  display: inline-grid;
+  place-items: center;
+}
+.voice-status {
+  padding: 0 28px 16px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 14px;
+  min-height: 38px;
+  color: var(--muted);
+}
+#statusMode {
+  color: var(--text);
+  font-weight: 550;
+}
+#voiceDetail {
+  margin-left: 4px;
+}
+.voice-bars {
+  display: inline-flex;
+  gap: 3px;
+  align-items: center;
+  height: 16px;
+  margin-left: auto;
+}
+.voice-bars i {
+  display: block;
+  width: 3px;
+  height: 4px;
+  background: var(--blue);
+  border-radius: 4px;
+  transition: height 80ms linear;
+}
+.chat-main {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+.chat-messages {
+  flex: 1;
+  overflow-y: auto;
+  min-height: 0;
+  padding: 24px 32px;
+  display: flex;
+  flex-direction: column;
+  gap: 28px;
+  scrollbar-width: thin;
+  scrollbar-color: var(--line) transparent;
+}
+.chat-empty {
+  margin: auto;
+  max-width: 440px;
+  width: 100%;
+  padding: 24px 0 48px;
+}
+.welcome-mark {

+  font-size: 14px;
+  gap: 12px;
+  z-index: 1;
+  pointer-events: none;
+}
+.avatar-frame[data-mode="approval"] {
+  border-color: #e6ad58;
+}
+.avatar-frame[data-mode="error"] {
+  border-color: #ff99a3;
+}
+.avatar-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
+  text-align: center;
+  flex-shrink: 0;
+}
+.avatar-state strong {
+  font-size: 16px;
+  font-weight: 600;
+}
+.avatar-state p {

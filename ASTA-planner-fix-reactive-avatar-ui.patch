+  }
+  .chat-recent {
+    position: absolute;
+    top: 52px;
+    bottom: 32px;
+    left: 0;
+    width: 240px;
+    z-index: 10;
+    box-shadow: 8px 0 20px rgba(0, 0, 0, 0.12);

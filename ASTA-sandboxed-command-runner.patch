+            if snapshot_path is not None:
+                shutil.rmtree(snapshot_path, ignore_errors=True)
+        if result is None:
+            result = _tool_result(
+                request,
+                success=False,
+                error="Sandbox execution ended without a result.",
+                start=start,
+            )
+        if cleanup_error:

+def test_kernel_shutdown_owns_shared_runtime_cleanup():
+    from core import Kernel
+    calls = []
+    kernel = Kernel()
+    kernel.model_runtime = SimpleNamespace(shutdown=lambda: calls.append("shutdown"))
+    kernel.shutdown()
+    kernel.shutdown()
+    assert calls == ["shutdown"]

# A.S.T.A. local runtime configuration
# Copy to .env and fill values that apply to your machine.

# Spotify Web API
ASTA_SPOTIFY_CLIENT_ID=
ASTA_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
ASTA_SPOTIFY_TOKEN_PATH=data/spotify_token.json

# Optional browser automation
# ASTA_BROWSER_CHANNEL=chrome
# ASTA_SPOTIFY_BROWSER_PROFILE=data/browser/spotify

# Experimental incremental voice execution (V1)
# When enabled, A.S.T.A. can commit safe application-open prefixes before the utterance ends.
ASTA_INCREMENTAL_VOICE=0
# Require the same semantic action to be observed this many partial STT updates.
ASTA_INCREMENTAL_STABLE_UPDATES=2
# Partial STT cadence/window. Lower cadence can feel faster but increases Whisper work.
ASTA_INCREMENTAL_STT_INTERVAL_MS=800
ASTA_INCREMENTAL_MIN_AUDIO_MS=850
ASTA_INCREMENTAL_STT_WINDOW_MS=5000

# Experimental cognitive agent planner (V1)
# Set to 1 to let the local LLM propose plans before the deterministic executor validates them.
ASTA_AGENT_MODE=0
# Structured agent inference uses a small deterministic budget to reduce control-loop latency.
ASTA_AGENT_MAX_OUTPUT_TOKENS=128
ASTA_AGENT_TEMPERATURE=0

# General local LLM runtime
ASTA_LLM_PROVIDER=llama_cpp
ASTA_LLAMA_SERVER_PATH=E:\\Projects\\llama\\llama-server.exe
# ASTA_LLM_MODEL_PATH=E:\\Projects\\llama\\models\\NVIDIA-Nemotron-3-Nano-4B-Q4_K_M.gguf
# 4096 is usually sufficient for the agent control loop and leaves more VRAM for voice/vision.
ASTA_LLM_CONTEXT_SIZE=4096
ASTA_LLM_GPU_LAYERS=99
ASTA_LLM_BATCH_SIZE=1024
ASTA_LLM_UBATCH_SIZE=512
ASTA_LLM_PARALLEL=1
ASTA_LLM_FLASH_ATTN=on
# Optional VRAM-saving KV cache quantization; requires Flash Attention in current llama.cpp builds.
# ASTA_LLM_CACHE_TYPE_K=q8_0
# ASTA_LLM_CACHE_TYPE_V=q8_0
ASTA_LLM_JINJA=1
ASTA_LLM_REASONING=off
ASTA_LLM_TEMPERATURE=0.7
ASTA_LLM_TIMEOUT=120

# Fast visual sensor (LFM2.5-VL-1.6B via an OpenAI-compatible local server)
# Example llama.cpp port: http://127.0.0.1:8090/v1
ASTA_VISION_BASE_URL=http://127.0.0.1:8090/v1
# Leave empty to use the first model reported by the vision server.
ASTA_VISION_MODEL=
ASTA_VISION_TIMEOUT=60
ASTA_VISION_MAX_OUTPUT_TOKENS=64
ASTA_VISION_TEMPERATURE=0
ASTA_VISION_PRELOAD=0
ASTA_VISION_SERVER_PATH=E:\\Projects\\llama\\llama-server.exe
ASTA_VISION_MODEL_DIR=E:\\Projects\\llama\\models
# Set these explicitly when automatic LFM2.5-VL discovery finds multiple GGUFs.
# ASTA_VISION_MODEL_PATH=E:\\Projects\\llama\\models\\LFM2.5-VL-1.6B-<quant>.gguf
# ASTA_VISION_MMPROJ_PATH=E:\\Projects\\llama\\models\\mmproj-LFM2.5-VL-1.6b-<variant>.gguf
ASTA_VISION_CONTEXT_SIZE=8192
ASTA_VISION_GPU_LAYERS=99
ASTA_VISION_MMPROJ_OFFLOAD=1
ASTA_VISION_JINJA=1
ASTA_VISION_SERVER_STARTUP_TIMEOUT=90
